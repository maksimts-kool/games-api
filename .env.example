# Port, millel API töötab
PORT=8080
# MongoDB ühendus (vaikimisi kohalik MongoDB, andmebaas games-api)
MONGODB_URI=mongodb://127.0.0.1:27017/games-api
# Admin kasutaja, tohib teha GET, POST, PUT ja DELETE päringuid (HTTP Basic auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Viewer kasutaja, tohib teha ainult GET päringuid (HTTP Basic auth)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-too
